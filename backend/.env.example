# Copy to .env and adjust as needed. All values are optional for local demo.

APP_NAME="Chargeback Copilot API"
ENVIRONMENT=development
API_PREFIX=/api

# SQLite is the zero-setup default; its schema is created automatically on startup.
# PostgreSQL uses psycopg 3. Plain postgresql:// and postgres:// URLs are
# normalized to postgresql+psycopg://. Run `alembic upgrade head` before the
# first PostgreSQL start; the API refuses to boot against an un-migrated schema.
# Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/chargeback
# Supabase (Session pooler; keep sslmode=require). URL-encode password special
# characters, then run `python scripts/check_database.py` and `alembic upgrade head`:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./chargeback.db

# Seed the 26-dispute demo workspace on startup.
SEED_DEMO_DATA=true

# Evidence file storage (relative paths resolve from the backend folder).
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# Whole-request ceiling enforced before parsing; keep above MAX_UPLOAD_MB so
# multipart framing overhead never rejects a legal upload.
MAX_REQUEST_MB=12

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT auth. Use a random 32+ character secret outside local development.
JWT_SECRET=dev-only-secret-change-me-in-production-32bytes-min
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# false: requests without a token are served as the demo merchant (easy frontend wiring).
# true: every /api endpoint except /health and /auth/* requires a Bearer token.
REQUIRE_AUTH=false

# AI drafting: "auto" uses the LLM when a key is set, otherwise heuristics.
# "heuristic" always uses the deterministic generator. "llm" requires LLM_API_KEY.
AI_MODE=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Any OpenAI-compatible provider works. Groq example:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25

# PayPal sandbox OAuth (merchant account connection).
# Create a sandbox app at developer.paypal.com, add this redirect URI to it,
# and paste the app's client ID/secret here. The secret stays on the server —
# never put it in a VITE_* variable.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_REDIRECT_URI=http://localhost:8000/api/paypal/oauth/callback
PAYPAL_RETURN_URL=http://localhost:5173/paypal
PAYPAL_SCOPES=openid email
PAYPAL_ENVIRONMENT=sandbox
# Fernet key used to encrypt stored access/refresh tokens. Falls back to a key
# derived from JWT_SECRET when empty. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYPAL_TOKEN_ENCRYPTION_KEY=

# Sandbox data sync (POST /api/paypal/sync) reads the Disputes/Payments/Orders/
# Refunds APIs. It uses the connected merchant token when its scope covers
# disputes, otherwise a client-credentials app token. Leave empty to use the
# environment default (sandbox: https://api-m.sandbox.paypal.com). Can also
# point at the offline mock: python scripts/mock_paypal_sandbox.py (127.0.0.1:9000).
PAYPAL_API_BASE=
# Optional order id used by GET /api/paypal/permissions to verify Orders access.
PAYPAL_SAMPLE_ORDER_ID=
